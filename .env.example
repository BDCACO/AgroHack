# Copie para .env e ajuste:  cp .env.example .env
# O .env NUNCA é commitado (está no .gitignore).

# Ambiente: development | test | production. Valor fora da lista = API não sobe.
ENVIRONMENT=development

# Login com papéis (dono e funcionário): true | false. Desligada, a API fica aberta como
# antes (só para desenvolvimento: o site e o app ainda não têm tela de login). Em
# production é obrigatória: sem AUTENTICACAO=true a API não sobe. Ligada, crie o primeiro
# dono com: make usuario-dono LOGIN=maria NOME="Dona Maria"
AUTENTICACAO=false

# PostgreSQL. A senha entra numa URL de conexão: use só letras e números
# (gere com: openssl rand -hex 16).
POSTGRES_DB=campocerto
POSTGRES_USER=campocerto
POSTGRES_PASSWORD=troque-esta-senha

# Portas publicadas no host.
DB_PORT=5433
API_PORT=8000
WEB_PORT=5173

LOG_LEVEL=INFO
