# Copie para .env e ajuste:  cp .env.example .env
# O .env NUNCA é commitado (está no .gitignore).

# Ambiente: development | test | production. Valor fora da lista = API não sobe.
ENVIRONMENT=development

# Login com papéis (dono e funcionário): true | false. Desligada, a API fica aberta como
# antes (só para desenvolvimento: o site e o app ainda não têm tela de login). Em
# production é obrigatória: sem AUTENTICACAO=true a API não sobe. Ligada, crie o primeiro
# dono com: make usuario-dono LOGIN=maria NOME="Dona Maria"
AUTENTICACAO=false

# PostgreSQL. A senha entra numa URL de conexão: use só letras e números
# (gere com: openssl rand -hex 16).
POSTGRES_DB=campocerto
POSTGRES_USER=campocerto
POSTGRES_PASSWORD=troque-esta-senha

# Papel da aplicação: o usuário com que a API conecta ao banco. Só lê e grava dados (não é
# superusuário, não cria nem apaga tabela); o POSTGRES_USER acima fica só para as
# migrations. A API o cria sozinha ao subir, também num banco que já existe. Senha só com
# letras e números, 12 ou mais (gere com: openssl rand -hex 16).
APP_DB_USER=campocerto_app
APP_DB_PASSWORD=troqueEstaSenhaDaApp

# Tempos-limite da API no banco, em milissegundos (opcionais; os padrões estão em
# backend/app/core/config.py). Zero não é aceito: no PostgreSQL, zero é "sem limite".
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Portas publicadas no host.
DB_PORT=5433
API_PORT=8000
WEB_PORT=5173

LOG_LEVEL=INFO
